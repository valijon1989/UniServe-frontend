# Use the remote API only when you have a backend running locally.
NEXT_PUBLIC_USE_REMOTE_API=0
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_WS_URL=ws://localhost:5001/ws
# Commerce mode:
# 0 (default): API-first with local fallback for cart/checkout/order flows
# 1: API-only (no local fallback; backend commerce endpoints required)
NEXT_PUBLIC_COMMERCE_API_ONLY=0
# Optional: avatar upload endpoint(s), comma-separated.
# If omitted, frontend skips server upload and keeps avatar as local preview.
# Example: NEXT_PUBLIC_AVATAR_UPLOAD_ENDPOINTS=/users/me/avatar
# Optional: client-readable auth cookie names to expire during logout, comma-separated.
# Example: NEXT_PUBLIC_AUTH_COOKIE_NAMES=refreshToken,admin_session
# Top podium source: `trending` (default, no 404 probing) or `auto` (tries /home/top, /products/top, /services/top first).
NEXT_PUBLIC_HOME_TOP_SOURCE=trending
# CORS whitelist for backend (comma-separated origins)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
